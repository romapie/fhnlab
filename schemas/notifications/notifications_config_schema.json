{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Notification Configuration Schema",
  "description": "Schema for validating notification settings such as email alerts.",

  "type": "object",
  "additionalProperties": false,
  "required": ["enabled"],

  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Enable or disable all notifications."
    },

    "email": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "smtp_host", "smtp_port", "user", "password_env", "to"],

      "properties": {
        "enabled": { "type": "boolean" },

        "smtp_host": { "type": "string" },

        "smtp_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },

        "use_ssl": {
          "type": "boolean",
          "default": true
        },

        "user": { "type": "string" },

        "password_env": {
          "type": "string",
          "description": "Environment variable containing the SMTP password."
        },

        "from": { "type": "string" },

        "to": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          },
          "minItems": 1
        },

        "on_states": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CREATED",
              "INITIALIZED",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          }
        }
      }
    }
  }
}
