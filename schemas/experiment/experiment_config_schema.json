{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experiment configuration schema",
  "type": "object",

  "required": [
    "experiment_name",
    "model_config",
    "solver_config",
    "output_path"
  ],

  "properties": {
    "experiment_name": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "model_config": {
      "type": "string"
    },

    "solver_config": {
      "type": "string"
    },

    "plot_configs": {
      "type": "array",
      "items": { "type": "string" }
    },

    "logging_config": {
      "type": "string"
    },

    "execution": {
      "type": "object",
      "required": ["backend"],
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["local", "remote"]
        }
      },
      "additionalProperties": false
    },

    "output_path": {
      "type": "string"
    },

    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },

    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },

    "notes": {
      "type": "string"
    },

    "parameter_sweep": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
