{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FHNLab Plot Configuration Schema",
  "description": "Unified plot configuration schema supporting 1D, 2D, surface and 3D geometries.",

  "type": "object",
  "additionalProperties": false,
  "required": ["plots"],

  "properties": {

    "simulation_info": {
      "type": "object",
      "properties": {
        "geometry": {
          "type": "string",
          "enum": ["1D", "2D", "3D", "circle", "surface", "torus", "sphere"]
        },
        "domain_type": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "global_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "save_all": { "type": "boolean" },
        "output_directory": { "type": "string" },
        "file_format": {
          "type": "string",
          "enum": ["png", "pdf", "svg", "eps", "gif"]
        },
        "dpi": {
          "type": "integer",
          "minimum": 72,
          "maximum": 600
        },
        "transparent": { "type": "boolean" },
        "bbox_inches": {
          "type": "string",
          "enum": ["tight", "standard"]
        }
      }
    },

    "plots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/plot_object" }
    }
  },

  "definitions": {

    "plot_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plot_name", "plot_type"],

      "properties": {

        "plot_name": { "type": "string" },

        "plot_type": {
          "type": "string",
          "enum": [
            "time_series",
            "space_profile",
            "phase_plane",
            "heatmap",
            "3d_surface",
            "histogram",
            "correlation",
            "circular",
            "custom"
          ]
        },

        "geometry": {
          "type": "string",
          "enum": ["1D", "2D", "3D", "circle", "surface", "torus", "sphere"]
        },

        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subplot_grid": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "minItems": 2,
              "maxItems": 2
            },
            "shared_x_axis": { "type": "boolean" },
            "shared_y_axis": { "type": "boolean" },
            "figure_size": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },

        "subplots": {
          "type": "array",
          "items": { "$ref": "#/definitions/subplot_object" }
        },

        "time_snapshots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "times": {
              "type": "array",
              "items": { "type": "number" }
            },
            "time_unit": { "type": "string" }
          }
        },

        "spatial_locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coordinates": {
                "type": "array",
                "items": { "type": "number" }
              },
              "label": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        },

        "data_sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/data_source" }
        },

        "overlays": {
          "type": "array",
          "items": { "$ref": "#/definitions/overlay_object" }
        },

        "axes": { "$ref": "#/definitions/axes_object" },

        "colorbar": { "$ref": "#/definitions/colorbar_object" },

        "style": { "$ref": "#/definitions/style_object" },

        "annotations": {
          "type": "array",
          "items": { "$ref": "#/definitions/annotation_object" }
        },

        "animation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "frame_rate": { "type": "number" },
            "duration": { "type": "number" },
            "loop": { "type": "boolean" }
          }
        },

        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "save": { "type": "boolean" },
            "file_name": { "type": "string" },
            "file_format": {
              "type": "string",
              "enum": ["png", "pdf", "svg", "eps", "gif"]
            },
            "dpi": {
              "type": "integer",
              "minimum": 72,
              "maximum": 600
            },
            "transparent": { "type": "boolean" }
          }
        }
      }
    },

    "subplot_object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subplot_index": { "type": "integer", "minimum": 1 },
        "plot_type": { "type": "string" },
        "data_sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/data_source" }
        },
        "overlays": {
          "type": "array",
          "items": { "$ref": "#/definitions/overlay_object" }
        },
        "axes": { "$ref": "#/definitions/axes_object" },
        "colorbar": { "$ref": "#/definitions/colorbar_object" },
        "style": { "$ref": "#/definitions/style_object" }
      }
    },

    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable"],
      "properties": {
        "variable": { "type": "string" },
        "component": { "type": ["string", "null"] },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "style": {
          "type": "string",
          "enum": ["solid", "dashed", "dotted", "dashdot"]
        },
        "linewidth": { "type": "number" },
        "marker": { "type": "string" },
        "bins": { "type": "integer" }
      }
    },

    "overlay_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "nullcline",
            "trajectory",
            "annotation",
            "diffusion_field",
            "shaded_area",
            "text_box"
          ]
        },
        "variable": { "type": "string" },
        "equation": { "type": "string" },
        "y_data": { "type": "string" },
        "normalize": { "type": "boolean" },
        "label": { "type": "string" },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string" },
            "linestyle": { "type": "string" },
            "linewidth": { "type": "number" },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fill": { "type": "boolean" }
          }
        }
      }
    },

    "axes_object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_label": { "type": "string" },
        "y_label": { "type": "string" },
        "z_label": { "type": "string" },
        "x_lim": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "y_lim": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "z_lim": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "x_scale": { "type": "string", "enum": ["linear", "log"] },
        "y_scale": { "type": "string", "enum": ["linear", "log"] },
        "aspect": { "type": "string", "enum": ["auto", "equal"] }
      }
    },

    "colorbar_object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": { "type": "boolean" },
        "label": { "type": "string" },
        "limits": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "orientation": {
          "type": "string",
          "enum": ["vertical", "horizontal"]
        },
        "ticks": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },

    "annotation_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text_box"]
        },
        "text": { "type": "string" },
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "coordinate_system": {
          "type": "string",
          "enum": ["data", "axes_fraction"]
        }
      }
    },

    "style_object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "colormap": { "type": "string" },
        "background_alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": { "type": "boolean" },
            "location": { "type": "string" },
            "frameon": { "type": "boolean" }
          }
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": { "type": "boolean" },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "linestyle": { "type": "string" }
          }
        }
      }
    }
  }
}
