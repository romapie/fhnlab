{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Logging Configuration Schema",
  "type": "object",

  "required": ["version", "formatters", "handlers", "root"],

  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Logging configuration format version"
    },

    "formatters": {
      "type": "object",
      "description": "Formatter definitions",
      "additionalProperties": {
        "type": "object",
        "required": ["format"],
        "properties": {
          "format": {
            "type": "string"
          },
          "datefmt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },

    "handlers": {
      "type": "object",
      "description": "Handler definitions",
      "additionalProperties": {
        "type": "object",
        "required": ["class", "level", "formatter"],
        "properties": {
          "class": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
          },
          "formatter": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["a", "w"]
          },
          "table": {
            "type": "string"
          },
          "include_experiment_context": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },

    "root": {
      "type": "object",
      "description": "Root logger configuration",
      "required": ["level", "handlers"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        },
        "handlers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },

    "loggers": {
      "type": "object",
      "description": "Named logger configurations",
      "additionalProperties": {
        "type": "object",
        "required": ["level", "handlers"],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
          },
          "handlers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "propagate": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false
}
