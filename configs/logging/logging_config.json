{
    "version": 1,
    "level": "INFO",
    "formatters": {
      "standard": {
        "format": "%(asctime)s [%(levelname)s] %(name)s: %(message)s",
        "datefmt": "%Y-%m-%d %H:%M:%S"
      }
    },
    "handlers": {
      "console": {
        "class": "logging.StreamHandler",
        "level": "INFO",
        "formatter": "standard"
      },
      "file": {
        "class": "logging.FileHandler",
        "level": "DEBUG",
        "formatter": "standard",
        "filename": "logs/app.log",
        "mode": "a"
      },
      "database": {
        "class": "custom.DatabaseHandler",
        "level": "ERROR",
        "formatter": "standard",
        "table": "logs"
      }
    },
    "loggers": {
      "main": {
        "level": "INFO",
        "handlers": ["console", "file"],
        "propagate": true
      },
      "solver": {
        "level": "DEBUG",
        "handlers": ["file", "database"],
        "propagate": false
      }
    }
  }
  