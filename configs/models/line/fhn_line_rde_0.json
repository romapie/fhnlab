{
    "model_name": "FitzHugh-Nagumo",
    "model_type": "reaction_diffusion",
    "domain": "line",
    "variables": ["v", "w"],
    "rhs_equations": {
        "F_1": "1/epsilon * (v * (1 - v) * (v - alpha) - w)",
        "F_2": "beta * v - gamma * w"
    },
    "model_parameters": {
        "alpha": {
            "type": "constant",
            "value": 0.5,
            "description": "-",
            "unit": "-"
        },
        "beta": {
            "type": "constant",
            "value": 1.0,
            "description": "-",
            "unit": "-"
        },
        "gamma": {
            "type": "constant",
            "value": 0.2,
            "description": "-",
            "unit": "-"
        },
        "epsilon": {
            "type": "constant",
            "value": 0.001,
            "description": "-",
            "unit": "-"
        }
    },
    "diffusion_coefficients": {
        "D_1": {
            "type": "constant",
            "value": 0.0003,
            "description": "-",
            "unit": "-"
        },
        "D_2": {
            "type": "constant",
            "value": 0.0002,
            "description": "-",
            "unit": "-"
        }
    },
    "output_path": "-"
}