{
    "model_name": "FitzHugh-Nagumo",
    "model_type": "ODE",
    "domain": "line",
    "variables": ["v", "w"],
    "rhs_equation": {
        "F_1": "1/epsilon * (v * (1 - v) * (v - alpha) - w + I_ext)",
        "F_2": "beta * v - gamma * w"
    },
    "model_parameters": {
        "alpha": {
            "type": "constant",
            "value": 0.1,
            "description": "-",
            "unit": "-"
        },
        "beta": {
            "type": "constant",
            "value": 1.0,
            "description": "-",
            "unit": "-"
        },
        "gamma": {
            "type": "constant",
            "value": 0.3,
            "description": "-",
            "unit": "-"
        },
        "epsilon": {
            "type": "constant",
            "value": 1.0,
            "description": "-",
            "unit": "-"
        }
    },
    "external_current": {
        "type": "time_dependent",
        "expression": "sin(2*pi*t/T)",
        "parameters": { 
            "T": 20.0 
        },
        "description": "-",
        "unit": "-"
    },
    "output_path": "-"
}