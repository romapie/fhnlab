{
    "simulation_info": {
      "geometry": "circle",
      "domain_type": "circle_stationary"
    },
  
    "global_output": {
      "save_all": true,
      "output_directory": "./output/circle_simulation",
      "file_format": "pdf",
      "dpi": 300,
      "transparent": false,
      "bbox_inches": "tight"
    },
  
    "plots": [
      {
        "plot_name": "diffusion_coefficients_circle",
        "plot_type": "space_profile",
        "geometry": "circle",
        "layout": {
          "subplot_grid": [2, 1],
          "shared_x_axis": true,
          "figure_size": [10, 6]
        },
        "subplots": [
          {
            "subplot_index": 1,
            "data_sources": [
              {
                "variable": "K1",
                "label": "K₁ (spatially_varying)",
                "color": "red",
                "style": "solid",
                "linewidth": 2
              }
            ],
            "overlays": [
              {
                "type": "shaded_area",
                "y_data": "K1",
                "alpha": 0.3,
                "color": "red"
              }
            ],
            "axes": {
              "x_label": "Position along curve s",
              "y_label": "K₁ [diffusion for v]",
              "x_lim": [0, 10],
              "y_lim": [0.005, 0.015]
            }
          },
          {
            "subplot_index": 2,
            "data_sources": [
              {
                "variable": "K2",
                "label": "K₂ (spatially_varying)",
                "color": "blue",
                "style": "solid",
                "linewidth": 2
              }
            ],
            "overlays": [
              {
                "type": "shaded_area",
                "y_data": "K2",
                "alpha": 0.3,
                "color": "blue"
              }
            ],
            "axes": {
              "x_label": "Position along curve s",
              "y_label": "K₂ [diffusion for w]",
              "x_lim": [0, 10],
              "y_lim": [0.0035, 0.0065]
            }
          }
        ],
        "style": {
          "title": "Diffusion Coefficients - Spatially varying (sinusoidal) diffusion",
          "grid": {"show": true, "alpha": 0.3}
        }
      },
  
      {
        "plot_name": "spacetime_evolution_circle",
        "plot_type": "heatmap",
        "geometry": "circle",
        "layout": {
          "subplot_grid": [2, 1],
          "figure_size": [10, 8]
        },
        "subplots": [
          {
            "subplot_index": 1,
            "data_sources": [
              {"variable": "v", "label": "v"}
            ],
            "axes": {
              "x_label": "Position along curve s",
              "y_label": "Time [ms]",
              "x_lim": [0, 10],
              "y_lim": [0, 1000]
            },
            "colorbar": {
              "show": true,
              "label": "v",
              "limits": [-0.2, 1.0],
              "orientation": "vertical"
            },
            "style": {
              "title": "Variable v: Space-Time Evolution (spatially_varying diffusion)",
              "colormap": "RdBu_r"
            }
          },
          {
            "subplot_index": 2,
            "data_sources": [
              {"variable": "w", "label": "w"}
            ],
            "axes": {
              "x_label": "Position along curve s",
              "y_label": "Time [ms]",
              "x_lim": [0, 10],
              "y_lim": [0, 1000]
            },
            "colorbar": {
              "show": true,
              "label": "w",
              "limits": [0.0, 0.12],
              "orientation": "vertical"
            },
            "style": {
              "title": "Variable w: Space-Time Evolution (spatially_varying diffusion)",
              "colormap": "viridis"
            }
          }
        ]
      },
  
      {
        "plot_name": "snapshots_grid_circle",
        "plot_type": "space_profile",
        "geometry": "circle",
        "layout": {
          "subplot_grid": [6, 2],
          "shared_x_axis": true,
          "figure_size": [12, 14]
        },
        "time_snapshots": {
          "times": [0, 100, 200, 400, 600, 800],
          "time_unit": "ms"
        },
        "data_sources": [
          {"variable": "v", "color": "blue", "style": "solid", "linewidth": 2},
          {"variable": "w", "color": "green", "style": "solid", "linewidth": 2}
        ],
        "overlays": [
          {
            "type": "diffusion_field",
            "variable": "K1",
            "style": {
              "color": "red",
              "alpha": 0.2,
              "fill": true
            },
            "normalize": true,
            "label": "K₁ (normalized)"
          }
        ],
        "axes": {
          "x_label": "Position along curve s",
          "x_lim": [0, 10]
        },
        "style": {
          "title": "Snapshots - spatially_varying diffusion",
          "grid": {"show": true}
        }
      },
  
      {
        "plot_name": "circular_visualization",
        "plot_type": "circular",
        "geometry": "circle",
        "layout": {
          "subplot_grid": [2, 3],
          "figure_size": [15, 10]
        },
        "time_snapshots": {
          "times": [0, 250, 500, 750, 900, 990],
          "time_unit": "ms"
        },
        "data_sources": [
          {"variable": "v", "label": "v"}
        ],
        "colorbar": {
          "show": true,
          "label": "v value",
          "limits": [-0.2, 1.2],
          "orientation": "horizontal"
        },
        "style": {
          "title": "Evolution on Circle - spatially_varying diffusion",
          "colormap": "RdBu_r",
          "circle_radius": 1.0,
          "circle_width": 0.15
        }
      },
  
      {
        "plot_name": "phase_portrait_circle",
        "plot_type": "phase_plane",
        "geometry": "circle",
        "spatial_locations": [
          {"coordinates": [0.0], "label": "s=0.00 (K₁=1.0e-02)", "color": "C0"},
          {"coordinates": [2.5], "label": "s=2.50 (K₁=1.0e-02)", "color": "C1"},
          {"coordinates": [5.0], "label": "s=5.00 (K₁=1.0e-02)", "color": "C2"},
          {"coordinates": [7.5], "label": "s=7.50 (K₁=1.0e-02)", "color": "C3"}
        ],
        "data_sources": [
          {"variable": "v_w_trajectory", "style": "solid", "linewidth": 1.5}
        ],
        "overlays": [
          {
            "type": "nullcline",
            "variable": "v",
            "label": "v-nullcline",
            "style": {
              "color": "red",
              "linestyle": "dashed",
              "linewidth": 2
            }
          },
          {
            "type": "nullcline",
            "variable": "w",
            "label": "w-nullcline",
            "style": {
              "color": "blue",
              "linestyle": "dashed",
              "linewidth": 2
            }
          }
        ],
        "axes": {
          "x_label": "v",
          "y_label": "w",
          "x_lim": [-0.2, 1.0],
          "y_lim": [-0.1, 0.5]
        },
        "style": {
          "title": "Phase Portrait (spatially_varying diffusion)",
          "legend": {
            "show": true,
            "location": "upper left"
          },
          "grid": {"show": true, "alpha": 0.3}
        }
      },
  
      {
        "plot_name": "wave_propagation_circle",
        "plot_type": "time_series",
        "geometry": "circle",
        "data_sources": [
          {
            "variable": "peak_position",
            "label": "Peak position",
            "color": "blue",
            "style": "solid",
            "linewidth": 2
          }
        ],
        "axes": {
          "x_label": "Time [ms]",
          "y_label": "Peak position s",
          "x_lim": [0, 1000],
          "y_lim": [0, 10]
        },
        "style": {
          "title": "Wave Propagation Analysis (spatially_varying diffusion)",
          "grid": {"show": true},
          "legend": {"show": false}
        },
        "annotations": [
          {
            "type": "text_box",
            "text": "Diffusion: spatially_varying",
            "position": [0.05, 0.95],
            "coordinate_system": "axes_fraction"
          }
        ]
      },
  
      {
        "plot_name": "diffusion_effects_circle",
        "plot_type": "correlation",
        "geometry": "circle",
        "layout": {
          "subplot_grid": [2, 2],
          "figure_size": [12, 10]
        },
        "subplots": [
          {
            "subplot_index": 1,
            "plot_type": "circular",
            "data_sources": [
              {"variable": "K1", "label": "K₁"}
            ],
            "colorbar": {
              "show": true,
              "label": "K₁",
              "limits": [0.005, 0.015]
            },
            "style": {
              "title": "K₁ distribution on circle",
              "colormap": "hot"
            }
          },
          {
            "subplot_index": 2,
            "plot_type": "circular",
            "data_sources": [
              {"variable": "K2", "label": "K₂"}
            ],
            "colorbar": {
              "show": true,
              "label": "K₂",
              "limits": [0.0035, 0.0065]
            },
            "style": {
              "title": "K₂ distribution on circle",
              "colormap": "hot"
            }
          },
          {
            "subplot_index": 3,
            "plot_type": "space_profile",
            "data_sources": [
              {"variable": "mean_v", "color": "blue", "label": "Mean v"}
            ],
            "overlays": [
              {
                "type": "diffusion_field",
                "variable": "K1",
                "style": {"color": "red", "alpha": 0.3, "linestyle": "dashed"}
              }
            ],
            "axes": {
              "x_label": "Position s",
              "y_label": "Mean v",
              "x_lim": [0, 10]
            },
            "style": {
              "title": "Correlation: Mean activity vs diffusion"
            }
          },
          {
            "subplot_index": 4,
            "plot_type": "space_profile",
            "data_sources": [
              {"variable": "var_v", "color": "green", "label": "Var(v)"}
            ],
            "overlays": [
              {
                "type": "diffusion_field",
                "variable": "K1",
                "style": {"color": "red", "alpha": 0.3, "linestyle": "dashed"}
              }
            ],
            "axes": {
              "x_label": "Position s",
              "y_label": "Var(v)",
              "x_lim": [0, 10]
            },
            "style": {
              "title": "Correlation: Variance vs diffusion"
            }
          }
        ],
        "style": {
          "title": "Spatially Varying Diffusion Effects"
        }
      },
  
      {
        "plot_name": "final_distributions_circle",
        "plot_type": "histogram",
        "geometry": "circle",
        "layout": {
          "subplot_grid": [1, 2],
          "figure_size": [10, 4]
        },
        "subplots": [
          {
            "subplot_index": 1,
            "data_sources": [
              {"variable": "v_final", "color": "blue", "bins": 50}
            ],
            "axes": {
              "x_label": "v value",
              "y_label": "Frequency"
            },
            "style": {
              "title": "Distribution of v at final time"
            }
          },
          {
            "subplot_index": 2,
            "data_sources": [
              {"variable": "w_final", "color": "green", "bins": 50}
            ],
            "axes": {
              "x_label": "w value",
              "y_label": "Frequency"
            },
            "style": {
              "title": "Distribution of w at final time"
            }
          }
        ]
      }
    ]
  }